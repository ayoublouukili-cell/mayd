# Local development: no Supabase account or email activation required.
# Copy this file to .env.local before running npm run dev.
VITE_LOCAL_ADMIN=true

# For the existing Supabase backend, use VITE_LOCAL_ADMIN=false and
# configure these values in your local environment or hosting settings:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Keep server credentials in the server environment, never in VITE_* variables.
